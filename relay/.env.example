# Example environment file for relay.py
# Copy this to .env and fill in your values, or pass as CLI arguments

# Serial port of the ground station ESP32 (e.g., COM3 on Windows, /dev/ttyUSB0 on Linux)
SERIAL_PORT=COM3

# Cloud ingest API endpoint (Vercel, or your own server)
CLOUD_INGEST_URL=https://your-dashboard.vercel.app/api/ingest

# Bearer token for cloud API authentication
CLOUD_API_TOKEN=your-secret-token-here
