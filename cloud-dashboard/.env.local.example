# Example environment file for cloud-dashboard (Next.js)
# Copy this to .env.local and fill in your database URL

# PostgreSQL connection string (Neon, Supabase, or your own database)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/rocket_telemetry

# Ingest API token (must match relay.py's --api-token)
INGEST_API_TOKEN=your-secret-token-here
